/* app.css — shared styles for auth + dashboard, matching the pub-ai.vercel.app landing page palette */

:root {
  --bg: #0e0f12;
  --panel: #16181d;
  --panel-border: #24262c;
  --text: #f2f0ec;
  --text-dim: #9a9a9e;
  --accent: #e8a13d;
  --accent-dark: #c07f26;
  --danger: #e35d5d;
  --radius: 10px;
  font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  min-height: 100vh;
}

a { color: var(--accent); text-decoration: none; }

/* ---------- Auth page ---------- */
.auth-wrap {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
}

.auth-card {
  width: 100%;
  max-width: 380px;
  background: var(--panel);
  border: 1px solid var(--panel-border);
  border-radius: var(--radius);
  padding: 32px 28px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 700;
  font-size: 18px;
  margin-bottom: 24px;
}

.brand-dot {
  width: 10px; height: 10px; border-radius: 50%;
  background: var(--accent);
}

.field { margin-bottom: 16px; }

.field label {
  display: block;
  font-size: 13px;
  color: var(--text-dim);
  margin-bottom: 6px;
}

.field input {
  width: 100%;
  padding: 11px 12px;
  border-radius: 8px;
  border: 1px solid var(--panel-border);
  background: #1c1e24;
  color: var(--text);
  font-size: 14px;
}

.field input:focus {
  outline: none;
  border-color: var(--accent);
}

.btn-primary {
  width: 100%;
  padding: 12px;
  border-radius: 8px;
  border: none;
  background: var(--accent);
  color: #14100a;
  font-weight: 600;
  font-size: 14px;
  cursor: pointer;
}

.btn-primary:hover { background: var(--accent-dark); }
.btn-primary:disabled { opacity: 0.6; cursor: default; }

.mode-toggle {
  display: block;
  text-align: center;
  margin-top: 16px;
  font-size: 13px;
  cursor: pointer;
}

.error-box {
  color: var(--danger);
  font-size: 13px;
  margin-bottom: 12px;
  min-height: 16px;
}

/* ---------- Dashboard ---------- */
.dash-shell { display: flex; min-height: 100vh; }

.sidebar {
  width: 220px;
  background: var(--panel);
  border-right: 1px solid var(--panel-border);
  padding: 24px 16px;
  flex-shrink: 0;
}

.sidebar .brand { margin-bottom: 32px; }

.nav-item {
  display: block;
  padding: 10px 12px;
  border-radius: 8px;
  color: var(--text-dim);
  font-size: 14px;
  margin-bottom: 4px;
  cursor: pointer;
}

.nav-item.active, .nav-item:hover { background: #1c1e24; color: var(--text); }

.main { flex: 1; padding: 32px 40px; max-width: 720px; }

.page-title { font-size: 22px; font-weight: 700; margin-bottom: 4px; }
.page-sub { color: var(--text-dim); font-size: 14px; margin-bottom: 28px; }

.card {
  background: var(--panel);
  border: 1px solid var(--panel-border);
  border-radius: var(--radius);
  padding: 24px;
  margin-bottom: 20px;
}

.card h3 { margin: 0 0 16px 0; font-size: 15px; }

textarea, select {
  width: 100%;
  padding: 11px 12px;
  border-radius: 8px;
  border: 1px solid var(--panel-border);
  background: #1c1e24;
  color: var(--text);
  font-size: 14px;
  font-family: inherit;
  resize: vertical;
}

.file-drop {
  border: 1px dashed var(--panel-border);
  border-radius: 8px;
  padding: 20px;
  text-align: center;
  color: var(--text-dim);
  font-size: 13px;
  cursor: pointer;
  margin-top: 8px;
}

.file-drop.has-file { border-color: var(--accent); color: var(--text); }

.badge {
  display: inline-block;
  padding: 3px 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
}

.badge.inactive { background: #332417; color: var(--accent); }
.badge.active { background: #1c3324; color: #6ee394; }

.event-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid var(--panel-border);
  font-size: 14px;
}

.event-row:last-child { border-bottom: none; }
.event-status { font-size: 12px; color: var(--text-dim); }

.top-bar {
  display: flex;
  justify-content: flex-end;
  padding: 16px 40px 0 0;
}

.logout-link { font-size: 13px; color: var(--text-dim); cursor: pointer; }
